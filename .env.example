# Copie este arquivo para .env e preencha com sua chave real.
# O .env NUNCA deve ser commitado nem enviado no .zip/Colab de entrega.

OLLAMA_API_KEY=sua_chave_do_ollama_cloud_aqui

# Backend dos embeddings (nomic-embed-text): auto | cloud | local
#   auto  = tenta o Ollama Cloud e, se der 401/erro, usa o Ollama local
#   local = exige Ollama instalado + `ollama pull nomic-embed-text`
EMBEDDING_BACKEND=auto
